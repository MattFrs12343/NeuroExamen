# NeuroExamenes - Apache rewrite rules (backend PHP)

Options -Indexes
DirectorySlash Off
ServerSignature Off
RewriteEngine On

# ------------------------------------------------------------------
# HTTPS redirect (solo fuera de localhost; tolera proxies/CDN)
# ------------------------------------------------------------------
<IfModule mod_rewrite.c>
    RewriteCond %{HTTPS} off
    RewriteCond %{HTTP:X-Forwarded-Proto} !https
    RewriteCond %{HTTP_HOST} !^localhost [NC]
    RewriteCond %{HTTP_HOST} !^127\.0\.0\.1 [NC]
    RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
</IfModule>

# ------------------------------------------------------------------
# Security headers
# ------------------------------------------------------------------
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    # SAMEORIGIN (no DENY): la página de verificación (/verificar/...)
    # necesita incrustarse a sí misma un <iframe> con el PDF que ella misma
    # sirve, mismo origen. Se intentó condicionar esto solo a esa ruta con
    # RewriteRule [E=...] y con SetEnvIf, pero mod_rewrite reprocesa TODO
    # el .htaccess otra vez después de la reescritura interna a index.php,
    # y para esa segunda pasada %{REQUEST_URI}/Request_URI ya cambió a
    # "/index.php" — la condición nunca llegaba a coincidir, sin importar
    # el mecanismo usado. Más simple y confiable: SAMEORIGIN para toda la
    # API (sigue bloqueando cualquier otro origen, que es lo que de verdad
    # importa contra clickjacking).
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
    Header always set Cross-Origin-Opener-Policy "same-origin"
    Header always unset X-Powered-By
    # HSTS solo cuando la conexión ya es HTTPS
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains" "expr=%{HTTPS} == 'on'"
    # El CSP del frontend (public/.htaccess) manda frame-ancestors 'none' y
    # se hereda hasta acá (los headers SÍ se heredan/mezclan correctamente
    # entre .htaccess padre e hijo — a diferencia del problema de arriba,
    # que era específico de mod_rewrite, no de esto) — se pisa acá con
    # 'self' por la misma razón que X-Frame-Options.
    Header always set Content-Security-Policy "default-src 'self'; script-src 'self'; connect-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; frame-src 'self'; frame-ancestors 'self'; base-uri 'self'; form-action 'self'"
</IfModule>

# ------------------------------------------------------------------
# No exponer errores ni versión de PHP (fallback si el host no permite ini_set)
# Se cubren los nombres de módulo más comunes (XAMPP, Apache mod_php, LiteSpeed)
# ------------------------------------------------------------------
<IfModule php_module>
    php_flag display_errors Off
    php_flag log_errors On
    php_flag expose_php Off
</IfModule>
<IfModule mod_php7.c>
    php_flag display_errors Off
    php_flag log_errors On
    php_flag expose_php Off
</IfModule>
<IfModule mod_php8.c>
    php_flag display_errors Off
    php_flag log_errors On
    php_flag expose_php Off
</IfModule>
<IfModule lsapi_module>
    php_flag display_errors Off
    php_flag log_errors On
    php_flag expose_php Off
</IfModule>

# ------------------------------------------------------------------
# Bloques de acceso directo a archivos sensibles
# (config/, sql/ y setup/ tienen su propio .htaccess con Deny)
# ------------------------------------------------------------------
<FilesMatch "(^\.env|\.env\.|\.sql$|\.example$|\.bak$|\.log$|\.zip$|\.tar$|\.gz$|\.inc$|\.pem$|\.key$|debug\.php$)">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# ------------------------------------------------------------------
# CRITICO: pasar el header Authorization a PHP (XAMPP/cieratos hosts lo bloquean)
# ------------------------------------------------------------------
RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

# ------------------------------------------------------------------
# Enrutar TODAS las peticiones que no sean archivos reales a index.php.
# NOTA: se excluye solo !-f (no !-d): los endpoints como /api/receta-clinics
# o /api/exams coinciden con directorios físicos y deben ir al router.
# ------------------------------------------------------------------
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^ index.php [QSA,L]