# ── Base de datos ─────────────────────────────────────────────────────────
# OBLIGATORIO en producción. Sin estos valores el backend rechaza la conexión
# (no usa credenciales por defecto).
DB_HOST=localhost
DB_NAME=neuroexamenes
DB_USER=tu_usuario_mysql
DB_PASS=tu_password_mysql

# ── JWT ───────────────────────────────────────────────────────────────────
# OBLIGATORIO: mínimo 32 caracteres aleatorios. Generar con:
#   php -r "echo bin2hex(random_bytes(32)), PHP_EOL;"
JWT_SECRET=REEMPLAZA_CON_TU_SECRET_DE_32_CARACTERES_MINIMO

# ── CORS ──────────────────────────────────────────────────────────────────
# En desarrollo: dejar vacío (acepta localhost automáticamente).
# En producción: dominio(s) EXACTO(s) del frontend, separados por coma.
# Es el único origen que recibirá cabeceras CORS + credenciales.
#   Ejemplo: ALLOWED_ORIGINS=https://pedidos.examenes-neuro.com
# Se conserva CORS_ORIGIN como alias de un único dominio.
ALLOWED_ORIGINS=
CORS_ORIGIN=

# ── Registro de usuarios ──────────────────────────────────────────────────
# Deshabilitado por defecto. Solo activar si realmente necesitas cuentas
# múltiples autogestionadas (el frontend actual NO usa /auth/register).
ALLOW_REGISTRATION=false

# ── Usuario médico titular (solo para seed.php, ejecutar por SSH/CLI) ─────
PROD_EMAIL=jmcabello_merida@hotmail.com
PROD_PASSWORD=REEMPLAZA_CON_PASSWORD_SEGURO
PROD_NAME=Dr. Juan Marcelo Cabello Mérida