# ── Base de datos ─────────────────────────────────────────────────────────
DB_HOST=localhost
DB_NAME=neuroexamenes
DB_USER=tu_usuario_mysql
DB_PASS=tu_password_mysql

# ── JWT ───────────────────────────────────────────────────────────────────
# OBLIGATORIO: mínimo 32 caracteres aleatorios
# Generar con: openssl rand -hex 32
JWT_SECRET=REEMPLAZA_CON_TU_SECRET_DE_32_CARACTERES_MINIMO

# ── CORS ──────────────────────────────────────────────────────────────────
# En desarrollo: dejar vacío (acepta localhost automáticamente)
# En producción: poner el dominio exacto del frontend
# Ejemplo: https://neuroexamenes.tudominio.com
CORS_ORIGIN=

# ── Usuario médico titular (solo para seed.php) ───────────────────────────
# Cambiar antes de ejecutar seed.php en producción
PROD_EMAIL=jmcabello_merida@hotmail.com
PROD_PASSWORD=REEMPLAZA_CON_PASSWORD_SEGURO
PROD_NAME=Dr. Juan Marcelo Cabello Mérida
