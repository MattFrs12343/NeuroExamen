# NeuroExamenes - Frontend (SPA estática generada por Vite)
# Se copia a dist/ automáticamente desde public/ durante npm run build.

Options -Indexes
ServerSignature Off

# ------------------------------------------------------------------
# HTTPS redirect
# ------------------------------------------------------------------
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteCond %{HTTPS} off
    RewriteCond %{HTTP:X-Forwarded-Proto} !https
    RewriteCond %{HTTP_HOST} !^localhost [NC]
    RewriteCond %{HTTP_HOST} !^127\.0\.0\.1 [NC]
    RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
</IfModule>

# ------------------------------------------------------------------
# Security headers
# ------------------------------------------------------------------
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "DENY"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains" "expr=%{HTTPS} == 'on'"
    # CSP: ajustar connect-src si el frontend y la API viven en dominios distintos.
    # frame-src 'self' blob: — sin esto, default-src 'self' bloquea en
    # silencio (sin excepción capturable en JS) el iframe oculto que
    # printPdfBlob() usa para imprimir el PDF firmado desde una blob: URL;
    # el usuario solo ve el spinner sin que pase nada, sin ningún error.
    Header always set Content-Security-Policy "default-src 'self'; script-src 'self'; connect-src 'self' https://pedidos.examenes-neuro.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data:; frame-src 'self' blob:; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
</IfModule>

# ------------------------------------------------------------------
# Nunca servir archivos de entorno ni mapas de origen en producción
# ------------------------------------------------------------------
<IfModule mod_headers.c>
    Header always set Cross-Origin-Opener-Policy "same-origin"
</IfModule>
<IfModule mod_headers.c>
    Header always unset Server
</IfModule>

# ------------------------------------------------------------------
# Cache-Control (SPA de Vite + Cloudflare)
#
# - index.html: revalidar siempre, para que cada deploy llegue rápido.
# - assets con hash (/assets/*.js|css): 1 año inmutable (el nombre cambia
#   en cada build, así que nunca sirven una versión vieja).
# - cid10.json / vademecum.json: catálogos grandes de nombre fijo; 1 día.
#   (En Cloudflare: regla "Cache Everything" para que se cacheen en el edge.)
# - /api/* (PHP): nunca cachear (datos dinámicos + autenticación).
# ------------------------------------------------------------------
<IfModule mod_headers.c>
    <FilesMatch "index\.html$">
        Header always set Cache-Control "no-cache, no-store, must-revalidate"
    </FilesMatch>

    <FilesMatch "\.php$">
        Header always set Cache-Control "no-store"
    </FilesMatch>

    <FilesMatch "\.(js|mjs|css)$">
        Header always set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>

    <FilesMatch "\.(png|webp|jpe?g|gif|ico|woff2?|ttf|eot)$">
        Header always set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>

    <FilesMatch "^(cid10|vademecum)\.json$">
        Header always set Cache-Control "public, max-age=86400"
    </FilesMatch>
</IfModule>